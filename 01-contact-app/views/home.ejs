    <%- include('partials/header.ejs') %>

    <!-- content -->
    <main class="py-5">
      <div class="container">
        <div class="row">
          <div class="col-md-12">
            <div class="card">
                <div class="card-header card-title">
                  <div class="d-flex align-items-center">
                    <h2 class="mb-0">All Contacts</h2>
                    <div class="ml-auto">
                      <a href="/add-contact" class="btn btn-success"><i class="fa fa-plus-circle"></i> Add New</a>
                    </div>
                  </div>
                </div>
              <div class="card-body">
                <table class="table table-striped table-hover">
                  <thead>
                    <tr>
                      <th scope="col">#</th>
                      <th scope="col">First Name</th>
                      <th scope="col">Last Name</th>
                      <th scope="col">Email</th>
                      <th scope="col">Phone</th>
                      <th scope="col">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                      <!-- Loop This -->
                  <% let srno = result.pagingCounter %>
                  <% let contacts = result.docs %>
                  <% contacts.forEach((contact) => { %>

                    <tr>
                      <td><%= srno++ %></td>
                      <td><%= contact.firstName %></td>
                      <td><%= contact.lastName %></td>
                      <td><%= contact.email %></td>
                      <td><%= contact.phone %></td>
                      <td width="150">
                        <a href="/show-contact/<%= contact._id %>" class="btn btn-sm btn-circle btn-outline-info" title="Show"><i class="fa fa-eye"></i></a>
                        <a href="/update-contact/<%= contact._id %>" class="btn btn-sm btn-circle btn-outline-secondary" title="Edit"><i class="fa fa-edit"></i></a>
                        <a href="/delete-contact/<%= contact._id %>" class="btn btn-sm btn-circle btn-outline-danger" title="Delete"><i class="fa fa-times"></i></a>
                      </td>
                    </tr>
                  <% }) %>
                    <!-- EO Loop This -->                    
                  </tbody>
                </table>
                <!-- Pagination --> 
                <% const prevPageDisabledClass = !result.hasPrevPage ? 'disabled' : '' %>
                <% const nextPageDisabledClass = !result.hasNextPage ? 'disabled' : '' %>
                <nav>
                  <ul class="pagination justify-content-center">
                    <li class="page-item <%= prevPageDisabledClass %>">
                      <a class="page-link" href="/?page=<%= result.prevPage %>">Previous</a>
                    </li>
                    <% for(let i=1; i<= result.totalPages; i++) { %>                    
                    <% const activeClass = result.page == i ? 'active' : '' %>                     
                    
                    <li class="page-item <%= activeClass %>"><a class="page-link" href="/?page=<%= i %>"><%= i %></a></li>
                    <% } %>
                    <li class="page-item <%= nextPageDisabledClass %>">
                      <a class="page-link" href="/?page=<%= result.nextPage %>">Next</a>
                    </li>
                  </ul>
                </nav>
                <!-- EO Pagination -->                 
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include('partials/footer.ejs') %>